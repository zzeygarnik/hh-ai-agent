# Скопируй этот файл в .env и заполни своими значениями.
# Либо запусти gui_app.py — он читает/пишет .env через удобную форму.

# --- Telegram ---
TG_BOT_TOKEN=ВАШ_ТОКЕН_ОТ_BOTFATHER
TG_USER_ID=ВАШ_TELEGRAM_ID

# --- LLM провайдер: "deepseek" (облако, платно по балансу) или "ollama" (локально, бесплатно) ---
LLM_PROVIDER=deepseek

# DeepSeek (нужен только если LLM_PROVIDER=deepseek)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Ollama (нужен только если LLM_PROVIDER=ollama, локальный сервер должен быть запущен)
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3

# --- Профиль для сопроводительных писем ---
MY_NAME=Твоё Имя
MY_GITHUB=
MY_PET_PROJECT=

# --- Поиск вакансий ---
# Не раскомментировано = используется список по умолчанию из config.py.
#SEARCH_QUERIES=Python backend, Python разработчик, FastAPI
#TARGET_RESUME_NAME=Backend-разработчик

# Не раскомментированная строка = используется значение по умолчанию из config.py.
# GUI (gui_app.py) пишет сюда многострочный текст резюме при сохранении.
#MY_RESUME_SUMMARY=

# Регионы поиска — по умолчанию (не раскомментировано) СПБ + удалённка по РФ, как ниже.
#SEARCH_REGION_MOSCOW=false
#SEARCH_REGION_SPB=true
#SEARCH_REGION_REMOTE=true
